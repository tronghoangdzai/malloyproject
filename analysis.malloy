source: vehicles is duckdb.table("vehicles.csv") extend {
  dimension: car_condition is `condition`
  dimension: car_year is `year`
  dimension: mileage_group is bin!(odometer, 20000)
  measure: average_price is avg(price)
  measure: listing_count is count()
}
//Top 15 Car Brands by Average Price
query: by_brand is vehicles -> {
  where: price > 1000 and price < 100000
  group_by: manufacturer
  aggregate: average_price
  order_by: average_price desc
  limit: 15
}

//Average Price by Fuel Type
query: by_fuel_type is vehicles -> {
  where: price > 1000 and price < 100000 and fuel is not null
  group_by: fuel
  aggregate: average_price
  order_by: average_price desc
}

//Average Price by Vehicle Condition
query: by_condition is vehicles -> {
  where: price > 1000 and price < 100000 and car_condition is not null
  group_by: car_condition
  aggregate: average_price
  order_by: average_price desc
}


//Top 20 States by Average Used Car Price
query: by_state is vehicles -> {
  where: price > 1000 and price < 100000 and state is not null
  group_by: state
  aggregate: average_price
  order_by: average_price desc
  limit: 20
}


//Average Used Car Price by Model Year
query: by_year is vehicles -> {
  where: price > 1000 and price < 100000 and car_year is not null
  group_by: car_year
  aggregate: average_price
  order_by: car_year desc
}
